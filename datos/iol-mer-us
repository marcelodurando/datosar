                contentType: 'application/json; charset=utf/8',
                data: data,
                success: function (d) {
                    if (d > 0)
                        window.location.assign('/Titulo/Index/' + d);
                },
                error: function () {
                    return false;
                }
            });
        });

        //Manejo de icono
        $('#userName').hover(function () {
            $('#arrow').toggleClass('down');
        });
    });

</script>

 

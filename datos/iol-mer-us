                        <a href="#" class="up btn btn-iol-success">
                            <span class="ico"></span>
                        </a>
                        <a href="#" class="down btn btn-danger">
                            <span class="ico"></span>
                        </a>
                    </div>
                    {{/PuedeVotar}}
                </div>
                {{/Expectativas}}
            </div>
        </div>
    </script>


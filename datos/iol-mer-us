            $('#login-modal').hide();
        });

        $('#login-modal').click(function (event) {
            event.stopPropagation();
        });

        $('.btn-iol-menu').hover(function () {
            var $botonIol = $(this).children('.btn-iol');
            var $icon = $botonIol.children('.sprite');
            alterIcon($icon, false);

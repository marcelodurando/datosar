                    <label for="">{{Periodo}}</label>
                    <div class="bars">
                        <div class="green" style="width: {{Positiva}}%;"></div>
                        <div class="gray" style="width: {{Neutral}}%;"></div>
                        <div class="red" style="width: {{Negativa}}%;"></div>
                    </div>
                    {{#PuedeVotar}}

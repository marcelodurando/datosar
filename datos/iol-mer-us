    }

    function noAceptar() {
        var currentUrl = document.location.href;
        if (currentUrl.indexOf("Comprar") >= 0) {
            $('#StopLoss').prop('checked', false);
        } else {
            $(".VentaAutomatica_Operacion").val(0);
        }
    }
    

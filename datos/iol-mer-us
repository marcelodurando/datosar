    function enviarRespuesta() {
        $.ajax({
            url: '/MiCuenta/EnviarRespuestaTyCStopLoss',
            dataType: "json",
            contentType: 'application/json; charset=UTF-8',
            success: function (success) {
                $('#modalStopLoss').modal('toggle');
